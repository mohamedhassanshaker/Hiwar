{
  "docs_root": "docs",
  "requirement_sources": [
    {
      "path": "docs/00-input-requirements/Hiwar-UI-Specification.md",
      "kind": "ui",
      "prefix": ""
    },
    {
      "path": "docs/00-input-requirements/tech-stack.md",
      "kind": "technical",
      "prefix": "tech"
    }
  ],
  "design_boards": "docs/00-input-requirements/Hiwar-claude-code-handoff.zip",
  "e2e": {
    "test_dir": "tests/e2e",
    "run": "bash scripts/test-e2e.sh"
  },
  "implement": {
    "verify": "make verify",
    "deploy": {
      "apps/web": "make deploy-web",
      "packages/": "make deploy-web && make deploy-agent",
      "services/ai-agent": "make deploy-agent",
      "*": "make deploy"
    }
  },
  "specs_dir": "docs/01-product-requirements/specs",
  "pm_dir": "docs/10-project-management",
  "crosscutting_module": "platform",
  "modules": {
    "inb": "Conversations inbox, takeover and handback",
    "agt": "Agents: configuration, testing, versions",
    "kno": "Knowledge sources and unanswered questions",
    "dep": "Deployments and the visitor widget",
    "ana": "Analytics",
    "bil": "Plan, usage and invoices",
    "org": "Team, roles, security and audit log",
    "web": "Public website",
    "ops": "Operator portal for the Hiwar team",
    "platform": "Cross-cutting rules, brand, shell, design system, personas, open items"
  },
  "id_patterns": [],
  "docs_structure": {
    "root": "docs",
    "areas": [
      {
        "dir": "00-input-requirements",
        "title": "Input requirements",
        "holds": "Requirement sources (business, UI, technical), design and reference archives, change requests",
        "files": [
          "business-specification.md"
        ],
        "folders": [
          "change-requests"
        ]
      },
      {
        "dir": "01-product-requirements",
        "title": "Product requirements",
        "holds": "Feature specs per module, UI coverage ledgers, glossary, non-functional rules, open questions",
        "files": [
          "glossary.md",
          "non-functional.md",
          "open-questions.md"
        ],
        "folders": [
          "specs"
        ]
      },
      {
        "dir": "02-architecture",
        "title": "Architecture",
        "holds": "System context, tech stack, solution design, AI platform, agent runtime, tenancy design",
        "files": [
          "overview.md",
          "tech-stack.md",
          "solution-design.md"
        ],
        "folders": []
      },
      {
        "dir": "03-decisions",
        "title": "Decisions",
        "holds": "Decision log, decision registers, architecture decision records (ADRs)",
        "files": [
          "decision-log.md",
          "0000-adr-template.md"
        ],
        "folders": []
      },
      {
        "dir": "04-api-and-integrations",
        "title": "APIs and integrations",
        "holds": "Platform, tutor and coach APIs; connectors, model providers, identity provider, external systems",
        "files": [
          "platform-api.md",
          "external-systems.md"
        ],
        "folders": []
      },
      {
        "dir": "05-data",
        "title": "Data",
        "holds": "Data model, data dictionary by domain, entity relationship diagrams",
        "files": [
          "data-model.md",
          "data-dictionary.md"
        ],
        "folders": [
          "data-dictionary",
          "erd"
        ]
      },
      {
        "dir": "06-security",
        "title": "Security",
        "holds": "Security architecture, identities, tenancy and roles",
        "files": [
          "security.md",
          "tenancy-and-roles.md"
        ],
        "folders": []
      },
      {
        "dir": "07-testing",
        "title": "Testing",
