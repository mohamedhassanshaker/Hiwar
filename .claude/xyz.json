        "files": [
          "specs-pending.md",
          "specs-completed.md",
          "task-backlog.md",
          "blockers.md",
          "progress-log.md"
        ],
        "folders": []
      }
    ],
    "root_files": [
      "README.md",
      "rules.md"
    ]
  }
