{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awp.tahseel.ae/schemas/attribute-definition.schema.json",
  "title": "AttributeDefinition",
  "description": "One dynamic attribute of a request type version or a work item type, as data model section 6 defines it. The list of definitions on a published version is compiled into the JSON Schema that validates AttributesJson.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "labelEn", "labelAr", "dataType", "order"],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "The key in AttributesJson. Suggested from the English label and never changed once published."
    },
    "labelEn": { "type": "string", "minLength": 1 },
    "labelAr": { "type": "string", "minLength": 1 },
    "dataType": {
      "enum": [
        "Text",
        "LongText",
        "Number",
        "Money",
        "Date",
        "DateTime",
        "Enum",
        "Boolean",
        "Person",
        "File",
        "Table"
      ]
    },
    "required": { "type": "boolean", "default": false },
    "enumValues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "labelEn", "labelAr"],
        "properties": {
          "value": { "type": "string" },
          "labelEn": { "type": "string" },
          "labelAr": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "columns": {
          "type": "array",
          "description": "For the Table data type: the columns of each row.",
          "items": { "$ref": "#" }
        }
      }
    },
    "order": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "dataType": { "const": "Enum" } }, "required": ["dataType"] },
      "then": { "required": ["enumValues"] }
    },
    {
      "if": { "properties": { "dataType": { "const": "Table" } }, "required": ["dataType"] },
      "then": {
        "properties": {
          "validation": { "required": ["columns"] }
        },
        "required": ["validation"]
      }
    }
  ]
}
