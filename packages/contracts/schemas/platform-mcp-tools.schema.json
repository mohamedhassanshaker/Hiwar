{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awp.tahseel.ae/schemas/platform-mcp-tools.schema.json",
  "title": "Platform MCP tools",
  "description": "The tools the platform MCP server at src/app/api/mcp/ offers an agent. Every one of them is the same code path a person's action takes, so it is permission-checked, validated and audited. The tier is the platform's own default; a project policy or an agent's trust may raise it, never lower it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tier", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "tier": { "enum": ["T0", "T1", "T2", "T3"] },
        "description": { "type": "string", "minLength": 1 },
        "permission": {
          "type": "string",
          "description": "The permission key the server checks before it runs the tool."
        },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" }
      }
    }
  },
  "examples": [
    {
      "tools": [
        {
          "name": "work_item_search",
          "tier": "T0",
          "permission": "work-items.read",
          "description": "Search the work items the acting person may see.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "status": { "type": "string" },
              "projectId": { "type": "string", "format": "uuid" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
            },
            "required": ["query"]
          }
        },
        {
          "name": "work_item_create",
          "tier": "T1",
          "permission": "work-items.create",
          "description": "Create a work item in a project the acting person may write to.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "projectId": { "type": "string", "format": "uuid" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "assigneeId": { "type": "string", "format": "uuid" },
              "dueAt": { "type": "string", "format": "date-time" },
              "attributesJson": { "type": "object" }
            },
            "required": ["projectId", "title"]
          },
          "outputSchema": {
            "type": "object",
            "properties": { "id": { "type": "string" }, "key": { "type": "string" } },
            "required": ["id", "key"]
          }
        },
        {
          "name": "request_transition",
          "tier": "T2",
          "permission": "requests.transition",
          "description": "Move a request to its next step. Pauses the run for an approval.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "requestId": { "type": "string", "format": "uuid" },
              "toStepKey": { "type": "string" },
              "note": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            },
            "required": ["requestId", "toStepKey", "version"]
          }
        },
        {
          "name": "person_delete",
          "tier": "T3",
          "permission": "people.delete",
          "description": "Never available to an agent. Declared so the refusal is explicit.",
          "inputSchema": {
            "type": "object",
            "properties": { "personId": { "type": "string", "format": "uuid" } },
            "required": ["personId"]
          }
        }
      ]
    }
  ]
}
