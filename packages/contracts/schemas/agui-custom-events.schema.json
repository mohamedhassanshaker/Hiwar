{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awp.tahseel.ae/schemas/agui-custom-events.schema.json",
  "title": "AWP AG-UI custom events",
  "description": "The CUSTOM events the harness publishes on top of the AG-UI protocol. The protocol's own events (TEXT_MESSAGE_*, TOOL_CALL_*, RUN_*, STEP_*) are defined by AG-UI and are not repeated here; these are the ones this platform adds, and the console reads them by name.",
  "oneOf": [
    { "$ref": "#/$defs/toolConfirmation" },
    { "$ref": "#/$defs/toolApproval" },
    { "$ref": "#/$defs/agentQuestion" },
    { "$ref": "#/$defs/contextComposition" },
    { "$ref": "#/$defs/budgetWarning" },
    { "$ref": "#/$defs/handoff" }
  ],
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{4}$",
      "description": "An estimated amount in AED, as numeric(18,4). Always an estimate, never a billed amount."
    },
    "toolConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.tool.confirmation" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callId", "toolName", "tier"],
          "properties": {
            "callId": { "type": "string" },
            "approvalId": { "type": "string" },
            "approvalKey": { "type": "string", "description": "The approval's key (APR-…), which the Inbox shows." },
            "toolName": { "type": "string" },
            "arguments": { "type": "object" },
            "tier": { "const": "T1" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "toolApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.tool.approval" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callId", "approvalId", "toolName", "tier"],
          "properties": {
            "callId": { "type": "string" },
            "approvalId": { "type": "string" },
            "approvalKey": { "type": "string", "description": "The approval's key (APR-…), which the Inbox shows." },
            "toolName": { "type": "string" },
            "arguments": { "type": "object" },
            "tier": { "const": "T2" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "agentQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.agent.question" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["questionId", "question"],
          "properties": {
            "questionId": { "type": "string" },
            "question": { "type": "string" },
            "options": { "type": "array", "items": { "type": "string" }, "description": "The answers the agent offers, when it offers a choice (UC-12.2-03)." },
            "fields": {
              "type": "array",
              "description": "Several values asked at once, drawn as a form; the answer comes back as one line per field (D252).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "label": { "type": "string" },
                  "options": { "type": "array", "items": { "type": "string" } },
                  "default": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "contextComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.run.context" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocks", "totalTokens"],
          "properties": {
            "totalTokens": { "type": "integer", "minimum": 0 },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "label", "tokens"],
                "properties": {
                  "kind": {
                    "enum": [
                      "platform-rules",
                      "organisation-rules",
                      "agent-instructions",
                      "skill-index",
                      "tool-definitions",
                      "task-frame",
                      "loaded-skills",
                      "retrieved-knowledge",
                      "memory",
                      "conversation",
                      "step-guidance"
                    ]
                  },
                  "label": { "type": "string" },
                  "tokens": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "budgetWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.run.budget" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spentAed", "limitAed", "action"],
          "properties": {
            "spentAed": { "$ref": "#/$defs/money" },
            "limitAed": { "$ref": "#/$defs/money" },
            "action": { "enum": ["Notify", "SwitchToCheaperRoute", "PauseAgent"] }
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "const": "awp.run.handoff" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "nextStep"],
          "properties": {
            "goal": { "type": "string" },
            "decisions": { "type": "array", "items": { "type": "string" } },
            "openQuestions": { "type": "array", "items": { "type": "string" } },
            "nextStep": { "type": "string" }
          }
        }
      }
    }
  }
}
