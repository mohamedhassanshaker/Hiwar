# The secrets `scripts/secrets-from-env.sh` turns into the cluster's Secrets (stack specification 9).
# Copy to .env.platform and fill every empty value marked "generate". The pods run with
# NODE_ENV=production, which refuses the published development values in apps/web/src/lib/env.ts.
#
#   cp .env.example.platform .env.platform
#   for k in AUTH_SECRET APP_KEK SECRET_KEY TEMPORAL_CODEC_KEY; do sed -i "s|^$k=$|$k=$(openssl rand -base64 32)|" .env.platform; done
#   for k in RUN_TOKEN_SIGNING_KEY MAINTENANCE_API_TOKEN AGENT_SERVICE_TOKEN PHOENIX_SECRET PHOENIX_API_KEY S3_SECRET_KEY; do sed -i "s|^$k=$|$k=$(openssl rand -hex 24)|" .env.platform; done

# generate: 32 bytes, base64
AUTH_SECRET=
APP_KEK=
SECRET_KEY=
TEMPORAL_CODEC_KEY=
TEMPORAL_CODEC_PREVIOUS_KEYS=

# generate: random strings
RUN_TOKEN_SIGNING_KEY=
MAINTENANCE_API_TOKEN=
AGENT_SERVICE_TOKEN=
PHOENIX_SECRET=
PHOENIX_API_KEY=

# The development object store's root user (MinIO). The password needs 8 or more characters.
S3_ACCESS_KEY=hiwar
# generate
S3_SECRET_KEY=

MAIL_FROM="Hiwar <no-reply@hiwar.localtest.me>"

# Written by scripts/db-credentials.sh from what CloudNativePG generates; leave empty.
DATABASE_URL=
DATABASE_RO_URL=
DATABASE_LISTEN_URL=
DATABASE_MIGRATE_URL=
KB_DATABASE_URL=

# Optional. Empty values are left out of the Secret.
UAEPASS_BASE_URL=
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
MODEL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEO4J_AUTH=
# Provider keys agentgateway holds; empty keeps the local model engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
