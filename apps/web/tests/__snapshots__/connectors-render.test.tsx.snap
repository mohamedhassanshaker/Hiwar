exports[`S-54 connectors > draws it read-only without connectors:write 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Connectors</h1><p>MCP servers and REST APIs that give agents controlled access to systems. Each connector sets the tier of every tool it exposes.</p></div></div><section class="awp-card"><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th></th><th>Connector</th><th>Transport</th><th>Auth</th><th>Tool tiers</th><th>Status</th></tr></thead><tbody><tr class="click"><td><button role="switch" aria-checked="true" class="awp-switch" data-on="1"><span></span></button></td><td><div><button class="awp-lnk-t">ERP</button><div class="awp-small awp-muted awp-mono">erp</div><div class="awp-small awp-muted">Finance ledger</div></div></td><td>Remote MCP</td><td>OAuth 2.1 sign-in (authorization code)</td><td><div class="awp-row" style="gap:4px;flex-wrap:wrap"><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--surface-neutral);box-shadow:inset 0 0 0 1px var(--border-subtle);color:var(--text-primary);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>T0 × 1</span></span><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-info-bg);box-shadow:inset 0 0 0 1px var(--feedback-info-border);color:var(--feedback-info-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>T1 × 1</span></span><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-warning-bg);box-shadow:inset 0 0 0 1px var(--feedback-warning-border);color:var(--feedback-warning-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>T2 × 1</span></span></div></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-bg);box-shadow:inset 0 0 0 1px var(--feedback-success-border);color:var(--feedback-success-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-icon);flex-shrink:0"></span><span>Healthy</span></span></td></tr><tr class="click"><td><button role="switch" aria-checked="false" class="awp-switch" data-on="0"><span></span></button></td><td><div><button class="awp-lnk-t">sandbox-fs</button><div class="awp-small awp-muted awp-mono">sandbox-fs</div><div class="awp-small awp-muted"></div></div></td><td>Local MCP (stdio)</td><td>None</td><td><div class="awp-row" style="gap:4px;flex-wrap:wrap"></div></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px)