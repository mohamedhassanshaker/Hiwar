exports[`S-41 people and roles > is read-only without permissions:write 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><h1>People &amp; roles</h1><p>Authorisation is evaluated on permission sets, never role names. Explicit deny wins.</p></div></div><div class="awp-tabs" role="tablist"><button role="tab" aria-selected="true" class="on">People<span class="awp-small awp-muted">3</span></button><button role="tab" aria-selected="false" class="">Roles<span class="awp-small awp-muted">2</span></button></div><section class="awp-card"><div class="awp-row" style="padding:14px 20px;flex-wrap:wrap;gap:12px;border-bottom:1px solid var(--border-divider)"><input class="awp-input" style="flex:1 1 240px;max-width:360px" placeholder="Search by name or email" aria-label="Search people" value=""/><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">Every status</button><button class="awp-chip">Active</button><button class="awp-chip">Invited</button><button class="awp-chip">Pending approval</button><button class="awp-chip">Suspended</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Name</th><th>Role</th><th>Organization</th><th>Sign-in</th><th>Status</th></tr></thead><tbody><tr class=""><td><div class="awp-row" style="gap:10px"><span style="position:relative;display:inline-flex" title="Quality Analyst"><span class="awp-pp" style="width:32px;height:32px;font-size:11.52px">QA</span></span><div><div style="font-weight:500">Quality Analyst</div><div class="awp-small awp-muted">qa@example.test</div></div></div></td><td>Member</td><td>Operations</td><td>SSO</td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-bg);box-shadow:inset 0 0 0 1px var(--feedback-success-border);color:var(--feedback-success-text);white-sp