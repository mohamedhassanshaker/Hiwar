exports[`S-76 and S-77 integrations > draws the client list 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Integrations</h1><p>External clients and what they may do. Each client has its own keys, MCP connection and AG-UI exposure.</p></div><div class="awp-ph-a"><button class="awp-btn awp-btn-primary"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--action-primary-bg);box-shadow:inset 0 0 0 1px var(--action-neutral-border);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><div style="position:relative;width:20px;height:20px;flex-shrink:0;color:var(--text-on-action)"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"><div style="width:24px;height:24px;overflow:visible;position:relative;color:currentColor;transform:scale(0.8333333333333334);transform-origin:0 0"><div style="position:absolute;left:2px;top:2px;width:20px;height:20px;overflow:visible"><svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="overflow:visible;position:absolute;left:6px;top:6px;width:8px;height:8px"><path d="M 4.75 0 C 4.75 -0.414 4.414 -0.75 4 -0.75 C 3.586 -0.75 3.25 -0.414 3.25 0 L 4 0 L 4.75 0 Z M 3.25 8 C 3.25 8.414 3.586 8.75 4 8.75 C 4.414 8.75 4.75 8.414 4.75 8 L 4 8 L 3.25 8 Z M 8 4.75 C 8.414 4.75 8.75 4.414 8.75 4 C 8.75 3.586 8.414 3.25 8 3.25 L 8 4 L 8 4.75 Z M 0 3.25 C -0.414 3.25 -0.75 3.586 -0.75 4 C -0.75 4.414 -0.414 4.75 0 4.75 L 0 4 L 0 3.25 Z M 4 0 L 3.25 0 L 3.25 8 L 4 8 L 4.75 8 L 4.75 0 L 4 0 Z M 8 4 L 8 3.25 L 0 3.25 L 0 4 L 0 4.75 L 8 4.75 L 8 4 Z" fill="currentColor" fill-rule="nonzero"></path></svg><svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="overflow:visible;position:absolute;left:0;top:0;transform:matrix(1,0,0,-1,0,20);transform-origin:0 0;width:20px;height:20px"><path d="M 20 10 L 19.25 10 C 19.25 15.109 15.109 19.25 10 19.25 L 10 20 L 10 20.75 C 15.937 20.75 20.75 15.937 20.75 10 L 20 10 Z M 10 20 L 10 19.25 C 4.891 19.25 0.75 15.109 0.75 10 L 0 10 L -0.75 10 C -0.75 15.937 4.063 20.75 10 20.75 L 10 20 Z M 0 10 L 0.75 10 C 0.75 4.891 4.891 0.75 10 0.75 L 10 0 L 10 -0.75 C 4.063 -0.75 -0.75 4.063 -0.75 10 L 0 10 Z M 10 0 L 10 0.75 C 15.109 0.75 19.25 4.891 19.25 10 L 20 10 L 20.75 10 C 20.75 4.063 15.937 -0.75 10 -0.75 L 10 0 Z" fill="currentColor" fill-rule="nonzero"></path></svg></div></div></span></div><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-on-action);flex-shrink:0">New client</span></div></button></div></div><section class="awp-card"><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Client</th><th>Owner</th><th>Allowed permissions</th><th>Agents</th><th style="text-align:end">Keys</th><th>MCP</th><th>AG-UI</th><th>Status</th></tr></thead><tbody><tr class="click"><td><div><b>ERP</b><div class="awp-small awp-muted awp-mono">cli_erp</div></div></td><td>Quality Analyst</td><td><div class="awp-row" style="flex-wrap:wrap;gap:4px"><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--surface-neutral);box-shadow:inset 0 0 0 1px var(--border-subtle);color:var(--text-primary);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>work_it