exports[`S-56 knowledge collections > draws the collection list with each status 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Knowledge</h1><p>Collections ingested into vector and graph stores for cited retrieval. Each collection has its own configuration and document sources.</p></div><div class="awp-ph-a"><button class="awp-btn"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--surface-card);border-top:1px solid var(--border-strong);border-right:1px solid var(--border-strong);border-bottom:1px solid var(--border-strong);border-left:1px solid var(--border-strong);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-primary);flex-shrink:0">Test knowledge retrieval</span></div></button><button class="awp-btn awp-btn-primary"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--action-primary-bg);box-shadow:inset 0 0 0 1px var(--action-neutral-border);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><div style="position:relative;width:20px;height:20px;flex-shrink:0;color:var(--text-on-action)"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"><div style="width:24px;height:24px;overflow:visible;position:relative;color:currentColor;transform:scale(0.8333333333333334);transform-origin:0 0"><div style="position:absolute;left:2px;top:2px;width:20px;height:20px;overflow:visible"><svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="overflow:visible;position:absolute;left:6px;top:6px;width:8px;height:8px"><path d="M 4.75 0 C 4.75 -0.414 4.414 -0.75 4 -0.75 C 3.586 -0.75 3.25 -0.414 3.25 0 L 4 0 L 4.75 0 Z M 3.25 8 C 3.25 8.414 3.586 8.75 4 8.75 C 4.414 8.75 4.75 8.414 4.75 8 L 4 8 L 3.25 8 Z M 8 4.75 C 8.414 4.75 8.75 4.414 8.75 4 C 8.75 3.586 8.414 3.25 8 3.25 L 8 4 L 8 4.75 Z M 0 3.25 C -0.414 3.25 -0.75 3.586 -0.75 4 C -0.75 4.414 -0.414 4.75 0 4.75 L 0 4 L 0 3.25 Z M 4 0 L 3.25 0 L 3.25 8 L 4 8 L 4.75 8 L 4.75 0 L 4 0 Z M 8 4 L 8 3.25 L 0 3.25 L 0 4 L 0 4.75 L 8 4.75 L 8 4 Z" fill="currentColor" fill-rule="nonzero"></path></svg><svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="overflow:visible;position:absolute;left:0;top:0;transform:matrix(1,0,0,-1,0,20);transform-origin:0 0;width:20px;height:20px"><path d="M 20 10 L 19.25 10 C 19.25 15.109 15.109 19.25 10 19.25 L 10 20 L 10 20.75 C 15.937 20.75 20.75 15.937 20.75 10 L 20 10 Z M 10 20 L 10 19.25 C 4.891 19.25 0.75 15.109 0.75 10 L 0 10 L -0.75 10 C -0.75 15.937 4.063 20.75 10 20.75 L 10 20 Z M 0 10 L 0.75 10 C 0.75 4.891 4.891 0.75 10 0.75 L 10 0 L 10 -0.75 C 4.063 -0.75 -0.75 4.063 -0.75 10 L 0 10 Z M 10 0 L 10 0.75 C 15.109 0.75 19.25 4.891 19.25 10 L 20 10 L 20.75 10 C 20.75 4.063 15.937 -0.75 10 -0.75 L 10 0 Z" fill="currentColor" fill-rule="nonzero"></path></svg></div></div></span></div><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-on-action);flex-shrink:0">New collection</span></div></button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Collections</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">3</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Documents</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">16</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Chunks</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">0.3k</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Entities</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">25</span></div></div><section class="awp-card"><div class="awp-card-h"><h3>Collections</h3></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Collection</th><th>Index type</th><th>Chunking</th><th>Embedding route</th><th style="text-align:end">Documents</th><th>Status</th><th style="text-align:end"></th></tr></thead><tbody><tr class="click"><td><div><button class="awp-lnk-t">HR policies</button><div class="awp-small awp-muted awp-mono">PRJ · Internal</div></div></td><td><span class="awp-small">Hybrid</span></td><td><span class="awp-small">Semantic · 800/80</span></td><td><span