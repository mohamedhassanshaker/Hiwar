tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-info-icon);flex-shrink:0"></span><span>Ingesting 40%</span></span></td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">Test retrieval</button><button class="awp-lnk">Configure</button></div></td></tr><tr class="click"><td><div><button class="awp-lnk-t">FAQ</button><div class="awp-small awp-muted awp-mono">PRJ · Public</div></div></td><td><span class="awp-small">Graph</span></td><td><span class="awp-small">Semantic · 800/80</span></td><td><span class="awp-mono awp-small">embedding-default</span></td><td style="text-align:end;white-space:nowrap">0</td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-warning-bg);box-shadow:inset 0 0 0 1px var(--feedback-warning-border);color:var(--feedback-warning-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-warning-icon);flex-shrink:0"></span><span>Degraded</span></span></td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">Test retrieval</button><button class="awp-lnk">Configure</button></div></td></tr></tbody></table></div></section></div>"`;
