exports[`S-73 to S-79 governance screens > draws the audit log 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Audit log</h1><p>Append-only record of configuration, permissions, approvals, publishes, secret access, exports and logins.</p></div><div class="awp-ph-a"><button class="awp-btn"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--surface-card);border-top:1px solid var(--border-strong);border-right:1px solid var(--border-strong);border-bottom:1px solid var(--border-strong);border-left:1px solid var(--border-strong);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><div style="position:relative;width:20px;height:20px;flex-shrink:0;color:var(--text-primary)"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"><div style="width:20px;height:20px;overflow:visible;position:relative;color:currentColor;transform:scale(0.8333333333333334);transform-origin:0 0"><div style="position:absolute;left:3.333px;top:3.75px;width:13.333px;height:12.5px;overflow:visible"><svg width="4.167" height="8.333" viewBox="0 0 4.167 8.333" fill="none" style="overflow:visible;position:absolute;left:4.583px;top:0;width:4.167px;height:8.333px"><path d="M 2.833 0 C 2.833 -0.414 2.498 -0.75 2.083 -0.75 C 1.669 -0.75 1.333 -0.414 1.333 0 L 2.083 0 L 2.833 0 Z M 0.538 5.727 C 0.249 5.43 -0.226 5.423 -0.523 5.712 C -0.82 6.001 -0.827 6.476 -0.538 6.773 L 0 6.25 L 0.538 5.727 Z M 4.704 6.773 C 4.993 6.476 4.986 6.001 4.689 5.712 C 4.392 5.423 3.918 5.43 3.629 5.727 L 4.167 6.25 L 4.704 6.773 Z M 2.083 8.333 L 2.833 8.333 L 2.833 0 L 2.083 0 L 1.333 0 L 1.333 8.333 L 2.083 8.333 Z M 2.083 8.333 L 2.083 7.583 C 2.181 7.583 2.226 7.615 2.197 7.6 C 2.1