68 C 11.684 1.723 11.334 1.75 10.833 1.75 L 10.833 2.5 Z" fill="currentColor" fill-rule="nonzero"></path></svg></div></div></span></div><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-primary);flex-shrink:0">Export</span></div></button></div></div><div class="awp-row" style="flex-wrap:wrap;gap:12px;align-items:flex-end"><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All actors</button><button class="awp-chip">People</button><button class="awp-chip">Agents</button></div><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip">Any time</button><button class="awp-chip">Last 24 hours</button><button class="awp-chip on">Last 7 days</button><button class="awp-chip">Last 30 days</button><button class="awp-chip">Last 90 days</button></div><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Action</span><input class="awp-input" placeholder="e.g. settings:" aria-label="Filter by action" value=""/></label></div><section class="awp-card"><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Object</th><th>Outcome</th><th>Detail</th></tr></thead><tbody><tr class=""><td><span class="awp-mono">13:00</span></td><td><div class="awp-row"><span style="position:relative;display:inline-flex" title="Quality Analyst"><span class="awp-pp" style="width:24px;height:24px;font-size:8.64px">QA</span></span>Quality Analyst</div></td><td><span class="awp-mono">work_items:write</span></td><td><button class="awp-lnk"><span class="awp-mono awp-small">PRJ-1</span></button></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-bg);box-shadow:inset 0 0 0 1px var(--feedback-success-border);color:var(--feedback-success-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>Allowed</span></span></td><td><span class="awp-small awp-muted">{}</span></td></tr><tr class=""><td><span class="awp-mono">13:05</span></td><td><div class="awp-row"><span style="position:relative;display:inline-flex" title="Quality Analyst"><span class="awp-pp" style="width:24px;height:24px;font-size:8.64px">QA</span></span>pa</div></td><td><span class="awp-mono">settings:write</span></td><td><button class="awp-lnk"><span class="awp-mono awp-small">Settings</span></button></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-danger-bg);box-shadow:inset 0 0 0 1px var(--feedback-danger-border);color:var(--feedback-danger-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>Denied</span></span></td><td><span class="awp-small awp-muted">{}</span></td></tr></tbody></table></div></section></div>"`;

exports[`S-73 to S-79 governance screens > draws the documentation 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Documentation</h1></div></div><div style="display:grid;grid-template-columns:240px minmax(0,1fr);gap:16px" class="awp-two"><section class="awp-card"><button class="awp-nav-i on" style="border-radius:0">Getting started</button><button class="awp-nav-i" style="border-radius:0">Requests</button></section><section class="awp-card"><div class="awp-card-h"><h3>Getting started</h3></div><div class="awp-card-b"><p style="margin:0;line-height:1.7;max-width:680px">Open the **Dashboard**.</p></div></section></div></div>"`;

exports[`S-73 to S-79 governance screens > draws the service log 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Logs</h1><p>Application and run logs across services.</p></div></div><div class="awp-row" style="flex-wrap:wrap;gap:12px;align-items:flex-end"><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All levels</button><button class="awp-chip">ERROR</button><button class="awp-chip">WARN</button><button class="awp-chip">INFO</button><button class="awp-chip">DEBUG</button></div><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Service</span><button type="button" class="awp-input awp-ps" aria-label="Filter by service" role="combobox" aria-haspopup="listbox" aria-controls="_R_l5_" aria-expanded="false"><span class="awp-ps-v">All services</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"><div style="width:24px;height:24px;overflow:hidden;position:relative;color:currentColor;transform:scale(0.75);transform-origin:0 0"><svg width="14" height="7.95" viewBox="0 0 14 7.950" fill="none" style="position:absolute;left:5px;top:9px;width:14px;height:7.95px"><path d="M 7 5.536 L 12.279 0.293 C 12.673 -0.098 13.311 -0.098 13.705 0.293 C 14.098 0.683 14.098 1.316 13.705 1.707 L 7.713 7.657 C 7.319 8.047 6.681 8.047 6.287 7.657 L 0.295 1.707 C -0.098 1.316 -0.098 0.683 0.295 0.293 C 0.689 -0.098 1.327 -0.098 1.721 0.293 L 7 5.536 Z" fill="currentColor" fill-rule="nonzero"></path></svg></div></span></button></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Run</span><input class="awp-input awp-mono" placeholder="run id" aria-label="Filter by run" value=""/></label></div><section class="awp-card"><div style="direction:ltr"><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Time</th><th>Level</th><th>Service</th><th>Run</th><th>Message</th></tr></thead><tbody><tr class=""><td><span class="awp-mono">13:00</span></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--surface-neutral);box-shadow:inset 0 0 0 1px var(--border-subtle);color:var(--text-primary);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>INFO</span></span></td><td><span class="awp-mono">awp-web</span></td><td><button class="awp-link awp-mono">c-1</button></td><td><span class="awp-mono">a request was served</span></td></tr><tr class=""><td><span class="awp-mono">13:01</span></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--surface-neutral);box-shadow:inset 0 0 0 1px var(--border-subtle);color:var(--text-primary);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span>ERROR</span></span></td><td><span class="awp-mono">awp-agent</span></td><td><span class="awp-mono">—</span></td><td><span class="awp-mono">an ingestion run did not start</span></td></tr></tbody></table></div></div></section></div>"`;

exports[`S-73 to S-79 governance screens > draws the settings 1`] = `"<div class="awp-page" style="max-width:1080px"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Settings</h1><p>Validated against schema. Every change is kept in history — version 4.</p></div><div class="awp-ph-a"><button class="awp-btn" disabled=""><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--surface-neutral);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-disabled);flex-shrink:0">Save changes</span></div></button></div></div><div class="awp-tabs" role="tablist"><button role="tab" aria-selected="true" class="on">General</button><button role="tab" aria-selected="false" class="">Branding</button><button role="tab" aria-selected="false" class="">Email</button></div><section class="awp-card"><div class="awp-card-h"><h3>Organisation</h3></div><div class="awp-card-b"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:16px"><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Name (English)</span><input class="awp-input" value="Tahseel"/></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Name (Arabic)</span><input class="awp-input" dir="rtl" value="تحصيل"/></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Time zone</span><input class="awp-input" value="Asia/Dubai"/></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Languages</span><input class="awp-input" value="en, ar"/></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Working calendar</span><input class="awp-input" value="Working week"/></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Holidays</span><input class="awp-input" value="UAE holidays"/></label></div></div></section></div>"`;

exports[`S-73 to S-79 governance screens > draws the system state 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>System</h1><p>Versions and health of every platform service.</p></div><div class="awp-ph-a"><button class="awp-btn"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--action-danger-bg);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--action-danger-fg);flex-shrink:0">Pause all agents</span></div></button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Active runs</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">3</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Queue depth</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">1</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Active rooms</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">2</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Dependencies healthy</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">1 / 2</span></div></div><p class="awp-small awp-muted" style="margin:0">Last checked <span class="awp-mono">13:00</span></p><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px;display:flex;flex-direction:column;gap:8px"><div class="awp-row"><b style="flex:1">postgres</b><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-bg);box-shadow:inset 0 0 0 1px var(--feedback-success-border);color:var(--feedback-success-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-icon);flex-shrink:0"></span><span>Healthy</span></span></div><span class="awp-small awp-muted awp-mono">18</span></div><div class="awp-card" style="padding:16px;display:flex;flex-direction:column;gap:8px"><div class="awp-row"><b style="flex:1">agent</b><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-danger-bg);box-shadow:inset 0 0 0 1px var(--feedback-danger-border);color:var(--feedback-danger-text);white-space:nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-danger-icon);flex-shrink:0"></span><span>Error</span></span></div><span class="awp-small awp-muted awp-mono">—</span><span class="awp-small" style="color:var(--feedback-danger-text)" role="status">connect ECONNREFUSED</span></div></div></div>"`;
