nowrap;font-family:var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, sans-serif;font-weight:500;font-size:12px;line-height:16px;font-variant-numeric:tabular-nums"><span aria-hidden="true" style="width:6px;height:6px;border-radius:calc(var(--radi-10) * 1px);background-color:var(--feedback-success-icon);flex-shrink:0"></span><span>Enabled</span></span></td><td><span class="awp-row" style="gap:2px" aria-label="4.5 / 5"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><span class="awp-small awp-muted" style="margin-inline-start:4px">4.5</span></span></td></tr><tr class="click"><td><div><b>Vendor intake</b><div class="awp-small awp-muted awp-mono">dep_two</div></div></td><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span>Default agent</button></td><td>Widget</td><td><span class="awp-small">—</span></td><td><span dir="ltr" style="display:inline-flex;align-items:center;gap:calc(var(--spacing-3) * 1px);height:24px;padding:0 calc(var(--spacing-5) * 1px);box-sizing:border-box;border