exports[`S-62 the embedded deployments > draws the list of deployments 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Embedded Deployment</h1><p>Agents published to websites and channels, with branding, security and storylines.</p></div><div class="awp-ph-a"><button class="awp-btn awp-btn-primary"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--action-primary-bg);box-shadow:inset 0 0 0 1px var(--action-neutral-border);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><div style="position:relative;width:20px;height:20px;flex-shrink:0;color:var(--text-on-action)"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"><div style="width:24px;height:24px;overflow:visible;position:relative;color:currentColor;transform:scale(0.8333333333333334);transform-origin:0 0"><div style="position:absolute;left:2px;top:2px;width:20px;height:20px;overflow:visible"><svg width="8" height="8" viewBox="0 0 8 8" fill="none" style="overflow:visible;position:absolute;left:6px;top:6px;width:8px;height:8px"><path d="M 4.75 0 C 4.75 -0.414 4.414 -0.75 4 -0.75 C 3.586 -0.75 3.25 -0.414 3.25 0 L 4 0 L 4.75 0 Z M 3.25 8 C 3.25 8.414 3.586 8.75 4 8.75 C 4.414 8.75 4.75 8.414 4.75 8 L 4 8 L 3.25 8 Z M 8 4.75 C 8.414 4.75 8.75 4.414 8.75 4 C 8.75 3.586 8.414 3.25 8 3.25 L 8 4 L 8 4.75 Z M 0 3.25 C -0.414 3.25 -0.75 3.586 -0.75 4 C -0.75 4.414 -0.414 4.75 0 4.75 L 0 4 L 0 3.25 Z M 4 0 L 3.25 0 L 3.25 8 L 4 8 L 4.75 8 L 4.75 0 L 4 0 Z M 8 4 L 8 3.25 L 0 3.25 L 0 4 L 0 4.75 L 8 4.75 L 8 4 Z" fill="currentColor" fill-rule="nonzero"></path></svg><svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="overflow:visible;position:absolute;