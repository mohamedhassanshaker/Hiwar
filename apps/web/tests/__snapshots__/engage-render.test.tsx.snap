exports[`S-64 the storyline editor > draws the draft with its first step open 1`] = `"<div class="awp-col" style="gap:16px"><div class="awp-row" style="flex-wrap:wrap;gap:12px"><div style="flex:1;min-width:200px"><b style="font-size:18px">card-replacement</b> <span class="awp-small awp-muted">· Draft version 3 · running version 2</span></div><div class="awp-seg"><button class="">Guided</button><button class="on">Strict</button></div><button class="awp-btn"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--surface-card);border-top:1px solid var(--border-strong);border-right:1px solid var(--border-strong);border-bottom:1px solid var(--border-strong);border-left:1px solid var(--border-strong);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;line-height:22px;color:var(--text-primary);flex-shrink:0">Simulate</span></div></button><button class="awp-btn awp-btn-primary"><div style="width:fit-content;height:36px;min-height:36px;border-radius:calc(var(--radi-6) * 1px);background-color:var(--action-primary-bg);box-shadow:inset 0 0 0 1px var(--action-neutral-border);display:flex;flex-direction:row;gap:calc(var(--spacing-3) * 1px);padding:0 calc(var(--spacing-7) * 1px) 0 calc(var(--spacing-7) * 1px);justify-content:center;align-items:center;box-sizing:border-box;position:relative"><span style="position:relative;font-family:var(--font), var(--font-family-primary), -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-weight: