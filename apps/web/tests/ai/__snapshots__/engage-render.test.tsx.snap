// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`S-62 the embedded deployments > draws the list of deployments 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Embedded Deployment</h1><p>Agents published to websites and channels, with branding, security and storylines.</p></div><div class="awp-ph-a"><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>New deployment</button></div></div><section class="awp-card"><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Deployment</th><th>Default agent</th><th aria-sort="none"><button type="button" class="th-sort">Surfaces</button></th><th>Storyline</th><th>Status</th><th>Rate</th></tr></thead><tbody><tr class="click"><td><div><b>Customer help</b><div class="awp-small awp-muted awp-mono">dep_one</div></div></td><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span>Default agent</button></td><td>Widget · WhatsApp</td><td><span class="awp-small">Card replacement v2</span></td><td><span class="badge success dot">Enabled</span></td><td><span class="awp-row" style="gap:2px" aria-label="4.5 / 5"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" fill="var(--icon-warning)"></path></svg><span class="awp-small awp-muted" style="margin-inline-start:4px">4.5</span></span></td></tr><tr class="click"><td><div><b>Vendor intake</b><div class="awp-small awp-muted awp-mono">dep_two</div></div></td><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span>Default agent</button></td><td>Widget</td><td><span class="awp-small">—</span></td><td><span class="badge secondary dot">Draft</span></td><td><span class="awp-muted">No ratings yet</span></td></tr></tbody></table></div></section></div>"`;

exports[`S-64 the storyline editor > draws the draft with its first step open 1`] = `"<div class="awp-col" style="gap:16px"><div class="awp-row" style="flex-wrap:wrap;gap:12px"><div style="flex:1;min-width:200px"><b style="font-size:18px">card-replacement</b> <span class="awp-small awp-muted">· Draft version 3 · running version 2</span></div><div class="awp-seg"><button class="">Guided</button><button class="on">Strict</button></div><button type="button" class="btn outline sm">Simulate</button><button type="button" class="btn sm">Publish</button></div><p class="awp-small awp-muted" style="margin:0" role="note">In strict mode the agent may only perform the current step, and exact messages are sent verbatim.</p><div style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,1fr);gap:16px" class="awp-two"><section class="awp-card"><div class="awp-card-h"><h3>Steps</h3><div class="awp-row" style="gap:8px"><input class="awp-input awp-mono" style="width:150px" aria-label="New step name" placeholder="step_name" value=""/><button type="button" class="btn outline sm" disabled=""><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>Add step</button></div></div><div class="awp-card-b"><div class="awp-col" style="gap:0"><div style="padding-inline-start:0"><button class="awp-card" style="width:100%;padding:12px 16px;text-align:start;cursor:pointer;display:flex;gap:12px;align-items:center;box-shadow:0 0 0 2px var(--border-selected)"><span class="awp-mono awp-muted" style="width:20px">1</span><div style="flex:1;min-width:0"><div class="awp-row" style="gap:8px;flex-wrap:wrap"><b class="awp-mono" style="font-size:13px">greet</b><span class="badge secondary">message</span><span class="badge secondary">exact</span></div><div class="awp-small awp-muted" style="margin-top:4px">Hello {{name}}.</div></div><span class="awp-row" style="gap:4px" title="Default agent"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span></span></button><div style="width:2px;height:14px;background:var(--border-divider);margin-inline-start:25px"></div></div><div style="padding-inline-start:0"><button class="awp-card" style="width:100%;padding:12px 16px;text-align:start;cursor:pointer;display:flex;gap:12px;align-items:center"><span class="awp-mono awp-muted" style="width:20px">2</span><div style="flex:1;min-width:0"><div class="awp-row" style="gap:8px;flex-wrap:wrap"><b class="awp-mono" style="font-size:13px">ask_reason</b><span class="badge ai">Ask</span></div><div class="awp-small awp-muted" style="margin-top:4px">Why do you need a new card?</div></div><span class="awp-row" style="gap:4px" title="Default agent"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span></span></button><div style="width:2px;height:14px;background:var(--border-divider);margin-inline-start:25px"></div></div><div style="padding-inline-start:40px"><button class="awp-card" style="width:100%;padding:12px 16px;text-align:start;cursor:pointer;display:flex;gap:12px;align-items:center"><span class="awp-mono awp-muted" style="width:20px">3</span><div style="flex:1;min-width:0"><div class="awp-row" style="gap:8px;flex-wrap:wrap"><b class="awp-mono" style="font-size:13px">block_card</b><span class="badge success">Tool</span></div><div class="awp-small awp-muted" style="margin-top:4px">Not configured yet</div></div><span class="awp-row" style="gap:4px" title="Default agent"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span><span class="badge ai">Override</span></span></button><div style="width:2px;height:14px;background:var(--border-divider);margin-inline-start:25px"></div></div><div style="padding-inline-start:0"><button class="awp-card" style="width:100%;padding:12px 16px;text-align:start;cursor:pointer;display:flex;gap:12px;align-items:center"><span class="awp-mono awp-muted" style="width:20px">4</span><div style="flex:1;min-width:0"><div class="awp-row" style="gap:8px;flex-wrap:wrap"><b class="awp-mono" style="font-size:13px">done</b><span class="badge secondary">End</span></div><div class="awp-small awp-muted" style="margin-top:4px">Not configured yet</div></div><span class="awp-row" style="gap:4px" title="Default agent"><span class="awp-ag" title="Default agent" style="width:24px;height:24px;font-size:9.120000000000001px;border-radius:50%">DF</span></span></button></div></div></div></section><section class="awp-card"><div class="awp-card-h"><h3>Step · greet</h3><button class="awp-lnk" style="color:var(--text-danger)">Delete step</button></div><div class="awp-card-b"><div class="awp-col" style="gap:14px"><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Step type</span><button type="button" class="awp-input awp-ps" role="combobox" aria-haspopup="listbox" aria-controls="_R_10qh_" aria-expanded="false"><span class="awp-ps-v">Message (say)</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Agent for this step</span><button type="button" class="awp-input awp-ps" role="combobox" aria-haspopup="listbox" aria-controls="_R_11ah_" aria-expanded="false"><span class="awp-ps-v">Default agent — Default agent</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button><span class="awp-small awp-muted">Uses the deployment default agent.</span></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Message (English)</span><textarea class="awp-input" style="height:70px;padding:12px">Hello {{name}}.</textarea></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Message (Arabic)</span><textarea class="awp-input" dir="rtl" style="height:70px;padding:12px">مرحباً {{name}}.</textarea></label><div class="awp-row"><button role="switch" aria-checked="true" class="awp-switch" data-on="1"><span></span></button><span>Send verbatim (exact)</span></div><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Phase mode</span><button type="button" class="awp-input awp-ps" role="combobox" aria-haspopup="listbox" aria-controls="_R_13qh_" aria-expanded="false"><span class="awp-ps-v">The storyline&#x27;s mode</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button><span class="awp-small awp-muted">Guided offers the script and answers anything else with the agent; Strict takes only the script.</span></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Tools</span><div class="awp-row" style="flex-wrap:wrap;gap:6px"><button class="awp-chip awp-mono" style="height:30px;font-size:12px">cards/block</button><button class="awp-chip awp-mono" style="height:30px;font-size:12px">crm/contact.lookup</button></div></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Skills</span><div class="awp-row" style="flex-wrap:wrap;gap:6px"><button class="awp-chip awp-mono" style="height:30px;font-size:12px">card-policy</button></div></label><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">Next step</span><button type="button" class="awp-input awp-ps" role="combobox" aria-haspopup="listbox" aria-controls="_R_4oah_" aria-expanded="false"><span class="awp-ps-v">ask_reason</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button></label><label class="awp-col" style="gap:6px"><span class="awp-small awp-muted">On error</span><button type="button" class="awp-input awp-ps" role="combobox" aria-haspopup="listbox" aria-controls="_R_58ah_" aria-expanded="false"><span class="awp-ps-v">Hand to a person</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button></label></div></div></div></section></div></div>"`;
