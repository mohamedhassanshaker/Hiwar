exports[`S-03 the page assistant > opens on the dashboard with its suggestions, as one agent with no hand-off 1`] = `"<div class="awp-card awp-assist is-d3 d3a" role="dialog" aria-label="AI Assistant"><div class="awp-card-h"><div class="d3a-h"><span class="awp-orb" style="width:32px;height:32px"><canvas style="width:40px;height:40px"></canvas></span><div><h3>AI Assistant</h3><span class="d3a-hs">Knows this page</span></div></div><span class="d3a-ha"><button class="awp-iconbtn" aria-pressed="false" aria-label="Saved chats" title="Saved chats"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5h-1L4 17.5v-3A3 3 0 0 1 2 11.7V6a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v.5"></path><path d="M10 9.5a2.5 2.5 0 0 1 2.5-2.5h7A2.5 2.5 0 0 1 22 9.5v5a2.5 2.5 0 0 1-2 2.45V20l-3.3-3h-4.2a2.5 2.5 0 0 1-2.5-2.5z"></path></svg></span></button><button class="awp-iconbtn" disabled="" aria-label="Name this chat" title="Name this chat"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span></button><button class="awp-iconbtn" aria-label="New chat" title="New chat"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span></button><button class="awp-iconbtn" aria-pressed="false" aria-label="Full screen" title="Full screen"><span aria-hidden="true">⤢</span></button><button class="awp-iconbtn" aria-label="Hide" title="Hide"><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button></span></div><div class="awp-card-b d3a-b"><div class="d3a-list" aria-live="polite"><p class="d3a-intro">Bound to this page with your permissions.</p><div class="d3a-sugg"><button class="awp-chip">Summarise this page</button><button class="awp-chip">What needs my attention today?</button></div></div><form class="d3a-form d3a-compose"><button type="button" class="awp-iconbtn d3a-add" style="width:40px;height:40px;border-radius:999px;flex-shrink:0" aria-expanded="false" aria-label="Go to a page or start something" title="Go to a page or start something"><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button><label class="awp-iconbtn d3a-file" style="width:40px;height:40px;border-radius:999px;flex-shrink:0;cursor:pointer" aria-label="Attach a file" title="Attach a file"><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--icon-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20.5 11.5-8.1 8.1a5 5 0 0 1-7.1-7.1l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8"></path></svg></span><input type="file" multiple="" accept=".pdf,.docx,.xlsx,.xls,.pptx,.json,.zip,.txt,.csv,.md,.html,.png,.jpg,.jpeg,.webp,.ppt" style="display:none"/></label><button type="button" class="awp-iconbtn awp-voice d3a-voice" aria-pressed="false" aria-busy="false" aria-label="Speak your message" title="Speak your message"><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--icon-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2.5" width="6" height="12" rx="3"></rect><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21.5M8.5 21.5h7"></path></svg></span></button><textarea class="awp-input d3a-ta" rows="1" placeholder="Ask about this page" aria-label="Message"></textarea><span class="d3a-mode" title="Approvals. Auto approves the approvals you decide as they arrive, for this conversation; Manual asks each time."><button type="button" class="awp-input awp-ps" aria-label="Approval mode" role="combobox" aria-haspopup="listbox" aria-controls="_R_b55_" aria-expanded="false"><span class="awp-ps-v">Manual</span><span class="awp-ic" aria-hidden="true" style="width:18px;height:18px"></span></button></span><button type="submit" class="d3a-send" disabled="" aria-label="Send"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg></span></button></form></div></div>"`;
