exports[`S-54 connectors > draws it read-only without connectors:write 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Connectors</h1><p>MCP servers and REST APIs that give agents controlled access to systems. Each connector sets the tier of every tool it exposes.</p></div></div><section class="awp-card"><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th></th><th>Connector</th><th aria-sort="none"><button type="button" class="th-sort">Transport</button></th><th aria-sort="none"><button type="button" class="th-sort">Auth</button></th><th>Tool tiers</th><th>Status</th></tr></thead><tbody><tr class="click"><td><button role="switch" aria-checked="true" class="awp-switch" data-on="1"><span></span></button></td><td><div><button class="awp-lnk-t">ERP</button><div class="awp-small awp-muted awp-mono">erp</div><div class="awp-small awp-muted">Finance ledger</div></div></td><td>Remote MCP</td><td>OAuth 2.1 sign-in (authorization code)</td><td><div class="awp-row" style="gap:4px;flex-wrap:wrap"><span class="badge secondary">T0 × 1</span><span class="badge info">T1 × 1</span><span class="badge warning">T2 × 1</span></div></td><td><span class="badge success dot">Healthy</span></td></tr><tr class="click"><td><button role="switch" aria-checked="false" class="awp-switch" data-on="0"><span></span></button></td><td><div><button class="awp-lnk-t">sandbox-fs</button><div class="awp-small awp-muted awp-mono">sandbox-fs</div><div class="awp-small awp-muted"></div></div></td><td>Local MCP (stdio)</td><td>None</td><td><div class="awp-row" style="gap:4px;flex-wrap:wrap"></div></td><td><span class="badge secondary dot">Disabled</span></td></tr></tbody></table></div></section></div>"`;

