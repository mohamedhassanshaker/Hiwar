// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`S-59 and S-60 models and routes > draws the provider cards for somebody who may change them 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Models &amp; routes</h1><p>Providers hold one or more connections; each connection allows specific models. Routes chain provider › connection › model.</p></div><div class="awp-ph-a"><button type="button" class="btn outline sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>Add custom provider</button><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>Add cloud provider</button></div></div><div class="awp-tabs" role="tablist"><button role="tab" aria-selected="true" class="on">Providers<span class="awp-small awp-muted">2</span></button><button role="tab" aria-selected="false" class="">Routes<span class="awp-small awp-muted">1</span></button></div><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All</button><button class="awp-chip">Active</button><button class="awp-chip">Not active</button><button class="awp-chip">Custom</button><button class="awp-chip">Cloud</button></div><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(260px,100%),1fr));gap:16px"><div class="awp-card" style="padding:18px;display:flex;flex-direction:column;gap:12px;cursor:pointer;opacity:1"><div class="awp-row" style="gap:12px"><span style="width:40px;height:40px;border-radius:12px;display:inline-grid;place-items:center;background:var(--chart-1);color:var(--text-on-action);font-weight:900;font-size:14.399999999999999px;flex-shrink:0">A</span><div style="flex:1;min-width:0"><b>Azure OpenAI</b><div class="awp-small awp-muted">Cloud provider</div></div><button role="switch" aria-checked="true" class="awp-switch" data-on="1"><span></span></button></div><div class="awp-row awp-small awp-muted" style="justify-content:space-between;border-top:1px solid var(--border-divider);padding-top:10px"><span>1 connections · 2 models allowed</span><span class="badge danger dot">Failed</span></div></div><div class="awp-card" style="padding:18px;display:flex;flex-direction:column;gap:12px;cursor:pointer;opacity:0.75"><div class="awp-row" style="gap:12px"><span style="width:40px;height:40px;border-radius:12px;display:inline-grid;place-items:center;background:var(--chart-2);color:var(--text-on-action);font-weight:900;font-size:14.399999999999999px;flex-shrink:0">L</span><div style="flex:1;min-width:0"><b>Local vLLM</b><div class="awp-small awp-muted">Custom · vLLM</div></div><button role="switch" aria-checked="false" class="awp-switch" data-on="0"><span></span></button></div><div class="awp-row awp-small awp-muted" style="justify-content:space-between;border-top:1px solid var(--border-divider);padding-top:10px"><span>0 connections · 0 models allowed</span><span class="badge secondary">Not connected</span></div></div></div></div>"`;

