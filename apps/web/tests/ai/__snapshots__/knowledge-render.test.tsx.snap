// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`S-56 knowledge collections > draws the collection list with each status 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Knowledge</h1><p>Collections ingested into vector and graph stores for cited retrieval. Each collection has its own configuration and document sources.</p></div><div class="awp-ph-a"><button type="button" class="btn outline sm">Test knowledge retrieval</button><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>New collection</button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Collections</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">3</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Documents</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">16</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Chunks</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">0.3k</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Entities</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">25</span></div></div><section class="awp-card"><div class="awp-card-h"><h3>Collections</h3></div><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Collection</th><th>Index type</th><th>Chunking</th><th>Embedding route</th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Documents</button></th><th>Status</th><th style="text-align:end" class="r"></th></tr></thead><tbody><tr class="click"><td><div><button class="awp-lnk-t">HR policies</button><div class="awp-small awp-muted awp-mono">PRJ · Internal</div></div></td><td><span class="awp-small">Hybrid</span></td><td><span class="awp-small">Semantic · 800/80</span></td><td><span class="awp-mono awp-small">embedding-default</span></td><td style="text-align:end;white-space:nowrap">12</td><td><span class="badge success dot">Healthy</span></td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">Test retrieval</button><button class="awp-lnk">Configure</button></div></td></tr><tr class="click"><td><div><button class="awp-lnk-t">Contracts</button><div class="awp-small awp-muted awp-mono">PRJ · Confidential</div></div></td><td><span class="awp-small">Vector</span></td><td><span class="awp-small">Semantic · 800/80</span></td><td><span class="awp-mono awp-small">embedding-default</span></td><td style="text-align:end;white-space:nowrap">4</td><td><span class="badge info dot">Ingesting 40%</span></td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">Test retrieval</button><button class="awp-lnk">Configure</button></div></td></tr><tr class="click"><td><div><button class="awp-lnk-t">FAQ</button><div class="awp-small awp-muted awp-mono">PRJ · Public</div></div></td><td><span class="awp-small">Graph</span></td><td><span class="awp-small">Semantic · 800/80</span></td><td><span class="awp-mono awp-small">embedding-default</span></td><td style="text-align:end;white-space:nowrap">0</td><td><span class="badge warning dot">Degraded</span></td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">Test retrieval</button><button class="awp-lnk">Configure</button></div></td></tr></tbody></table></div></section></div>"`;
