exports[`S-76 and S-77 integrations > draws the client list 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Integrations</h1><p>External clients and what they may do. Each client has its own keys, MCP connection and AG-UI exposure.</p></div><div class="awp-ph-a"><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>New client</button></div></div><section class="awp-card"><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Client</th><th aria-sort="none"><button type="button" class="th-sort">Owner</button></th><th>Allowed permissions</th><th>Agents</th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Keys</button></th><th>MCP</th><th>AG-UI</th><th>Status</th></tr></thead><tbody><tr class="click"><td><div><b>ERP</b><div class="awp-small awp-muted awp-mono">cli_erp</div></div></td><td>Quality Analyst</td><td><div class="awp-row" style="flex-wrap:wrap;gap:4px"><span class="badge secondary">work_items:read</span></div></td><td><div class="awp-row" style="gap:0"><span style="margin-inline-start:0;display:inline-flex"><span style="position:relative;display:inline-flex" title="Quality Analyst"><span class="awp-pp" style="width:24px;height:24px;font-size:8.64px">QA</span></span></span></div></td><td style="text-align:end;white-space:nowrap">2</td><td><span class="badge success">On</span></td><td><span class="badge secondary">Off</span></td><td><span class="badge success dot">Active</span></td></tr><tr class="click"><td><div><b>Portal</b><div class="awp-small awp-muted awp-mono">cli_portal</div></div></td><td>Quality Analyst</td><td><div class="awp-row" style="flex-wrap:wrap;gap:4px"><span class="badge secondary">agents:invoke</span></div></td><td><span class="awp-muted">—</span></td><td style="text-align:end;white-space:nowrap">0</td><td><span class="badge secondary">Off</span></td><td><span class="badge success">On</span></td><td><span class="badge secondary dot">Inactive</span></td></tr></tbody></table></div></section></div>"`;
