// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`S-71 and S-72 budgets > draws it read-only without budgets:write 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Budgets &amp; estimated costs</h1><p>Budgets apply to agents. All costs are estimates based on token usage and list prices.</p></div><div class="awp-ph-a"><button type="button" class="btn outline sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>Export</button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Estimated month to date</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">AED 460.00</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Agents with a budget</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">1 / 3</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Over 90%</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-danger);overflow-wrap:anywhere">1</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Ending within 90 days</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">0</span></div></div><section class="awp-card"><div class="awp-row" style="padding:14px 20px;flex-wrap:wrap;gap:12px;border-bottom:1px solid var(--border-divider)"><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All</button><button class="awp-chip">Active</button><button class="awp-chip">Scheduled</button><button class="awp-chip">Expired</button></div></div><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Agent</th><th>Effective</th><th>Status</th><th>Usage this period</th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Estimated spend</button></th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Limit</button></th><th style="text-align:end" class="r"></th></tr></thead><tbody><tr class="click"><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Expense checker" style="width:26px;height:26px;font-size:9.88px;border-radius:50%">EX</span>Expense checker</button></td><td><span class="awp-mono awp-small">2026-10-01 → no end date</span></td><td><span class="badge success dot">Active</span></td><td><div class="awp-row" style="min-width:180px"><div style="flex:1"><div class="awp-bar" style="height:6px"><span style="width:92%;background:var(--icon-danger)"></span></div></div><span class="awp-small">92%</span></div></td><td style="text-align:end;white-space:nowrap">AED 460.00</td><td style="text-align:end;white-space:nowrap">AED 500.00 / mo</td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">History</button></div></td></tr><tr class="click"><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Expense checker" style="width:26px;height:26px;font-size:9.88px;border-radius:50%">EX</span>Expense checker</button></td><td><span class="awp-mono awp-small">2026-11-01 → 2026-12-31</span></td><td><span class="badge info dot">Scheduled</span></td><td><span class="awp-muted">—</span></td><td style="text-align:end;white-space:nowrap">AED 0.00</td><td style="text-align:end;white-space:nowrap">AED 200.00 / weekly</td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">History</button></div></td></tr></tbody></table></div></section></div>"`;

exports[`S-71 and S-72 budgets > draws the list for somebody who may change budgets 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">Govern</div><h1>Budgets &amp; estimated costs</h1><p>Budgets apply to agents. All costs are estimates based on token usage and list prices.</p></div><div class="awp-ph-a"><button type="button" class="btn outline sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>Export</button><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>New agent budget</button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Estimated month to date</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">AED 460.00</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Agents with a budget</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">1 / 3</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Over 90%</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-danger);overflow-wrap:anywhere">1</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Ending within 90 days</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">0</span></div></div><section class="awp-card"><div class="awp-row" style="padding:14px 20px;flex-wrap:wrap;gap:12px;border-bottom:1px solid var(--border-divider)"><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All</button><button class="awp-chip">Active</button><button class="awp-chip">Scheduled</button><button class="awp-chip">Expired</button></div></div><div class="awp-row" style="justify-content:flex-end;gap:8px;padding:8px 16px;flex-wrap:wrap"><div role="group" aria-label="Layout" class="seg"><button type="button" aria-pressed="true" class="on">Table</button><button type="button" aria-pressed="false" class="">Cards</button></div></div><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Agent</th><th>Effective</th><th>Status</th><th>Usage this period</th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Estimated spend</button></th><th style="text-align:end" class="r" aria-sort="none"><button type="button" class="th-sort">Limit</button></th><th style="text-align:end" class="r"></th></tr></thead><tbody><tr class="click"><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Expense checker" style="width:26px;height:26px;font-size:9.88px;border-radius:50%">EX</span>Expense checker</button></td><td><span class="awp-mono awp-small">2026-10-01 → no end date</span></td><td><span class="badge success dot">Active</span></td><td><div class="awp-row" style="min-width:180px"><div style="flex:1"><div class="awp-bar" style="height:6px"><span style="width:92%;background:var(--icon-danger)"></span></div></div><span class="awp-small">92%</span></div></td><td style="text-align:end;white-space:nowrap">AED 460.00</td><td style="text-align:end;white-space:nowrap">AED 500.00 / mo</td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">History</button><button class="awp-lnk">Edit</button></div></td></tr><tr class="click"><td><button class="awp-row awp-lnk-t" style="gap:8px"><span class="awp-ag" title="Expense checker" style="width:26px;height:26px;font-size:9.88px;border-radius:50%">EX</span>Expense checker</button></td><td><span class="awp-mono awp-small">2026-11-01 → 2026-12-31</span></td><td><span class="badge info dot">Scheduled</span></td><td><span class="awp-muted">—</span></td><td style="text-align:end;white-space:nowrap">AED 0.00</td><td style="text-align:end;white-space:nowrap">AED 200.00 / weekly</td><td style="text-align:end;white-space:nowrap"><div class="awp-row" style="justify-content:flex-end;gap:12px"><button class="awp-lnk">History</button><button class="awp-lnk">Edit</button></div></td></tr></tbody></table></div></section></div>"`;
