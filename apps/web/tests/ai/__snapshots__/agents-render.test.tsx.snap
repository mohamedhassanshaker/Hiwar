exports[`S-51 each tab of one agent > shows the versions tab 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px"><button class="awp-lnk">AI Capabilities / Agents</button></div><h1><span class="awp-row" style="gap:14px"><span class="awp-ag" title="Expense Reviewer" style="width:48px;height:48px;font-size:18.240000000000002px;border-radius:50%">ER</span>Expense Reviewer</span></h1><p>Finance · v3 active</p></div><div class="awp-ph-a"><span class="badge secondary dot">Idle</span><button type="button" class="btn destructive sm">Delete agent</button><button type="button" class="btn sm">Publish new version</button></div></div><div class="awp-tabs" role="tablist"><button role="tab" aria-selected="false" class="">Overview</button><button role="tab" aria-selected="false" class="">Instructions</button><button role="tab" aria-selected="false" class="">Skills<span class="awp-small awp-muted">1</span></button><button role="tab" aria-selected="false" class="">Connector tools<span class="awp-small awp-muted">1</span></button><button role="tab" aria-selected="false" class="">Knowledge<span class="awp-small awp-muted">1</span></button><button role="tab" aria-selected="false" class="">Memory<span class="awp-small awp-muted">1</span></button><button role="tab" aria-selected="false" class="">Agent run list<span class="awp-small awp-muted">1</span></button><button role="tab" aria-selected="true" class="on">Versions<span class="awp-small awp-muted">1</span></button></div><section class="awp-card"><div style="overflow-x:auto"><table class="awp-tbl"><thead><tr><th>Version</th><th>Published</th><th>By</th><th>Eval</th><th style="text-align:end"></th></tr></thead><tbody><tr class=""><td class="awp-mono">v3</td><td>30 Sept</td><td>Quality Analyst</td><td>0.92</td><td style="text-align:end;white-space:nowrap"><span class="badge success dot">Active</span></td></tr></tbody></table></div></section></div>"`;

exports[`S-52 the run viewer > shows a finished run step by step 1`] = `"<div class="awp-page"><span data-live="off" hidden=""></span><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px"><span class="awp-row" style="gap:6px"><button class="awp-lnk">Agents</button>/<button class="awp-lnk">Expense Reviewer</button>/<button class="awp-lnk">Agent run list</button></span></div><h1><span class="awp-mono" style="font-size:26px;font-family:inherit">RUN-1042</span></h1><p>Review claim EXP-1042 · Expense Reviewer v3</p></div><div class="awp-ph-a"><span class="badge success dot">Completed</span><button type="button" class="btn outline sm">Replay</button><button type="button" class="btn destructive sm">Delete run</button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Duration</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">42.0s</span></div><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Tokens</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">2.2k</span><span class="awp-small awp-muted">35% cache hit</span></div><button type="button" aria-pressed="false" title="Show only the tool calls" style="all:unset;cursor:pointer;display:grid;border-radius:16px"><div class="awp-card" style="padding:16px 18px;display:flex;flex-direction:column;gap:4px"><span class="awp-small awp-muted awp-row" style="justify-content:space-between">Tool calls</span><span style="font-size:clamp(20px,2.2vw,26px);font-weight:900;line-height:1.35;color:var(--text-primary);overflow-wrap:anywhere">1</span><span class="awp-small awp-muted">Show their details</span></div></button></div><section class="awp-card"><div class="awp-card-h"><h3>Timeline</h3></div><div style="border-bottom:1px solid var(--border-divider)"><button type="button" aria-expanded="false" style="width:100%;border:0;background:transparent;padding:12px 20px;display:flex;gap:12px;align-items:center;cursor:pointer;text-align:start;color:inherit;font:inherit"><span style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--surface-sunken);flex-shrink:0"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"></span></span><div style="flex:1;min-width:0"><div style="font-weight:500">Started<span class="awp-small awp-muted"> · Succeeded</span></div><div class="awp-small awp-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">The run started.</div></div><div class="awp-small awp-muted" style="text-align:end;white-space:nowrap">0.01s</div><span style="display:inline-flex"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span></span></button></div><div style="border-bottom:1px solid var(--border-divider)"><button type="button" aria-expanded="false" style="width:100%;border:0;background:transparent;padding:12px 20px;display:flex;gap:12px;align-items:center;cursor:pointer;text-align:start;color:inherit;font:inherit"><span style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--surface-sunken);flex-shrink:0"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--icon-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6z"></path><path d="M6 3v18M4 7h4M4 12h4M4 17h4M11 8h5M11 12h5"></path></svg></span></span><div style="flex:1;min-width:0"><div style="font-weight:500">Planned the review<span class="awp-small awp-muted"> · Succeeded</span></div><div class="awp-small awp-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Read the claim.</div></div><div class="awp-small awp-muted" style="text-align:end;white-space:nowrap">1.20s</div><span style="display:inline-flex"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span></span></button></div><div style="border-bottom:1px solid var(--border-divider)"><button type="button" aria-expanded="false" style="width:100%;border:0;background:transparent;padding:12px 20px;display:flex;gap:12px;align-items:center;cursor:pointer;text-align:start;color:inherit;font:inherit"><span style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--surface-sunken);flex-shrink:0"><span class="awp-ic" aria-hidden="true" style="width:20px;height:20px"></span></span><div style="flex:1;min-width:0"><div style="font-weight:500">erp/claims.read<span class="awp-small awp-muted"> · Succeeded</span></div><div class="awp-small awp-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Read EXP-1042.</div></div><div class="awp-small awp-muted" style="text-align:end;white-space:nowrap">0.30s</div><span style="display:inline-flex"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span></span></button></div></section><section class="awp-card"><div class="awp-card-h"><h3>Context composition</h3></div><div class="awp-card-b"><div class="awp-bar" style="height:14px"><span style="width:1%;background:var(--chart-1)"></span></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;margin-top:14px"><div class="awp-row" style="font-size:13px"><span class="awp-dot" style="background:var(--chart-1)"></span><span style="flex:1">Instructions</span><span class="awp-muted">1%</span></div></div></div></section></div>"`;
