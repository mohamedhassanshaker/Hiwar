exports[`S-50 and S-51 the agents > lists the agents 1`] = `"<div class="awp-page"><div class="awp-ph"><div class="awp-ph-t"><div class="awp-small awp-muted" style="margin-bottom:4px">AI Capabilities</div><h1>Agents</h1><p>Versioned workers with skills, tools, memory and an org position.</p></div><div class="awp-ph-a"><button type="button" class="btn sm"><span class="awp-ic" aria-hidden="true" style="width:16px;height:16px"></span>New Agent</button></div></div><div class="awp-row" style="flex-wrap:wrap;gap:12px"><input class="awp-input" style="max-width:260px" placeholder="Search agents" aria-label="Search agents" value=""/><div class="awp-row" style="flex-wrap:wrap"><button class="awp-chip on">All</button><button class="awp-chip">Idle</button><button class="awp-chip">Running</button><button class="awp-chip">Waiting</button><button class="awp-chip">Paused</button><button class="awp-chip">Error</button><button class="awp-chip">Retired</button></div></div><div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(280px,100%),1fr));gap:16px"><button class="awp-card" style="padding:20px;text-align:start;cursor:pointer;display:flex;flex-direction:column;gap:14px"><div class="awp-row" style="gap:12px"><span class="awp-ag" title="Expense Reviewer" style="width:44px;height:44px;font-size:16.72px;border-radius:50%">ER</span><div style="flex:1;min-width:0"><div style="font-weight:900;font-size:16px">Expense Reviewer</div><div class="awp-small awp-muted">Finance · v3</div></div></div><div class="awp-row" style="flex-wrap:wrap"><span class="badge secondary dot">Idle</span><span class="badge secondary">task</span></div><div class="awp-row awp-small awp-muted" style="justify-content:space-between;border-top:1px solid var(--border-divider);padding-top:12px"><span class="awp-mono">reasoning-default</span><span>12 runs · AED 4.50</span></div></button></div></div>"`;

