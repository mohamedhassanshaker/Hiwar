    "db:seed:ai": "tsx src/db/ai-seed/index.ts",
    "db:seed:all": "npm run db:seed:ai && npm run db:seed",
    "ops:grant": "tsx src/db/grant-operator.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.5",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@copilotkit/react-core": "^1.89.0",
    "@copilotkit/runtime": "^1.89.0",
    "@kubernetes/client-node": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@temporalio/client": "^1.26.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.18",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.17.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "stripe": "^23.1.0",
    "undici": "^8.12.4",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
