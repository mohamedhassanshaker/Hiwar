# next-auth@5.0.0-beta.32 declares an optional peer on @simplewebauthn/browser@^9 and
# @simplewebauthn/server@^9, for its own WebAuthn provider. This project implements passkeys
# directly (src/features/organisation/service.ts) and never loads that provider, so the actual
# @simplewebauthn version here is independent of it; `npm ci` still refuses an unsatisfied peer
# range by default.
legacy-peer-deps=true
