# Stack specification 7.1: one CloudNativePG cluster `awp-pg` carrying every relational
# store the platform needs, each database owned by its own role.
#
#   awp                  domain, the system of record (web application only)
#   awp_kb               passage vectors with pgvector (agent service only)
#   temporal             Temporal persistence
#   temporal_visibility  Temporal visibility
#   phoenix              Arize Phoenix traces
instances: {{ .Values.postgres.instances }}
storage: {{ .Values.postgres.storage | quote }}
pooler: true
superuserAccess: true
databases: [awp, awp_kb, temporal, temporal_visibility, phoenix]
# `awp_kb` holds the vector index, so its extension is created with the database.
extensions:
  awp_kb: [vector, pg_trgm]
