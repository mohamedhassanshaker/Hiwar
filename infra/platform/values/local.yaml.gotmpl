# The `local` environment: one PostgreSQL instance, small volumes, and the two profiles of
# stack specification 8.7. `core` drops Phoenix and Neo4j, so Knowledge runs in Vector mode
# and traces are visible only in the console run timeline.
#
# Rook needs a raw block device on the node. A kind node on Windows or macOS has none, so
# `NO_ROOK=1` (the default here) leaves Rook out and runs the development object store
# instead; both speak the S3 API, which is all the application uses.
#
# `.gotmpl`, because helmfile only templates an environment values file with that suffix.
profile:
  tracing:
    enabled: {{ env "PROFILE" | default "full" | eq "full" }}
  graph:
    enabled: {{ env "PROFILE" | default "full" | eq "full" }}
  rook:
    enabled: {{ env "NO_ROOK" | default "1" | eq "0" }}
  devObjectStore:
    enabled: {{ env "NO_ROOK" | default "1" | ne "0" }}

postgres:
  instances: 1
  storage: 10Gi
